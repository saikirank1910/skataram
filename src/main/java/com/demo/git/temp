<?php
class Game {
    private $conn;
    private $table = 'games';

    public function __construct($db) {
        $this->conn = $db;
    }

    public function createGameWithUsers($gameName, $users) {
        try {
            $this->conn->beginTransaction();

            // Insert new game
            $query = "INSERT INTO {$this->table} (name) VALUES (:name)";
            $stmt = $this->conn->prepare($query);
            $stmt->bindParam(':name', $gameName);
            $stmt->execute();
            $gameId = $this->conn->lastInsertId();

            // Insert each user and link to the game
            foreach ($users as $user) {
                // Check if user already exists by email
                $query = "SELECT id FROM users WHERE email = :email";
                $stmt = $this->conn->prepare($query);
                $stmt->bindParam(':email', $user->email);
                $stmt->execute();
                $userId = $stmt->fetchColumn();

                // If user doesn't exist, create new
                if (!$userId) {
                    $query = "INSERT INTO users (first_name, last_name, email, dob) VALUES (:firstName, :lastName, :email, :dob)";
                    $stmt = $this->conn->prepare($query);
                    $stmt->bindParam(':firstName', $user->firstName);
                    $stmt->bindParam(':lastName', $user->lastName);
                    $stmt->bindParam(':email', $user->email);
                    $stmt->bindParam(':dob', $user->dob);
                    $stmt->execute();
                    $userId = $this->conn->lastInsertId();
                }

                // Link user to the game
                $query = "INSERT INTO game_users (game_id, user_id) VALUES (:gameId, :userId)";
                $stmt = $this->conn->prepare($query);
                $stmt->bindParam(':gameId', $gameId);
                $stmt->bindParam(':userId', $userId);
                $stmt->execute();
            }

            $this->conn->commit();
            return true;

        } catch (Exception $e) {
            $this->conn->rollBack();
            throw $e;
        }
    }

    public function getAllGames() {
        $query = "SELECT * FROM {$this->table}";
        $stmt = $this->conn->prepare($query);
        $stmt->execute();
        return $stmt->fetchAll(PDO::FETCH_ASSOC);
    }
}
?>


