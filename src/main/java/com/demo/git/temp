    `);
  });

  // Handle form submission to create a game with users
  $('#createGameForm').submit(function(event) {
    event.preventDefault();

    const gameName = $('#gameName').val();
    const users = [];

    // Gather all user data
    $('#usersList .user').each(function() {
      const user = {
        firstName: $(this).find('input[name="firstName"]').val(),
        lastName: $(this).find('input[name="lastName"]').val(),
        email: $(this).find('input[name="email"]').val(),
        dob: $(this).find('input[name="dob"]').val()
      };
      users.push(user);
    });

    // Make API call with game name and users array
    $.ajax({
      url: '/backend/index.php?route=create_game_with_users',
      method: 'POST',
      contentType: 'application/json',
      data: JSON.stringify({ gameName: gameName, users: users }),
      success: function(response) {
        alert('Game created successfully!');
        fetchGames(); // Refresh games list
      },
      error: function() {
        alert('Failed to create game.');
      }
    });
